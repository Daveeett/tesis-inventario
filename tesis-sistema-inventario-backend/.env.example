# Server Configuration
PORT=3001
NODE_ENV=development
# Generar un secreto aleatorio de al menos 32 caracteres; nunca subir el valor real.
JWT_SECRET=

# Frontend URL (for CORS)
FRONTEND_BASE_URL=http://localhost:4200

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=innovatecno_inventario

# Restablecer la contraseña de un administrador LOCAL (npm run admin:restablecer).
# Al menos 14 caracteres. Borrar la contraseña de aquí después de usarla.
ADMIN_RESET_EMAIL=
ADMIN_RESET_PASSWORD=
